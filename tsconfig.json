{
	// Checks the source; it never compiles it. `noEmit` is the point: what ships is what is written.
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		// TS7 stops auto-including node_modules/@types; without this every `process` reference dies on TS2591.
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true
	},
	"include": ["src/**/*.js", "scripts/**/*.js", "test/support/**/*.js"]
}

{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"lib": ["ES2022"],
		// Under the pinned 5.x this narrows the auto-included @types to node alone. It is
		// also what keeps the build alive on TypeScript 7, which stops auto-including every
		// package under node_modules/@types: without it the entire Node global surface
		// (process, console, node:*) goes invisible there and the build dies on TS2591 at
		// the first `process` reference.
		"types": ["node"],
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationMap": true,
		"sourceMap": true,
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"allowSyntheticDefaultImports": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "test", "**/*.test.ts"]
}
